# Supabase Auth est appelé uniquement par les routes serveur de Zentra.
# La clé publiable est la seule clé Supabase utilisée par ce flux : ne jamais
# ajouter une clé secret/service_role dans un bundle navigateur.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# US pilot persistence uses the existing server-only Supabase client.
# Never prefix this private key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Origine canonique HTTPS du site. Définir cette même origine comme Site URL
# dans Supabase Auth et autoriser exactement `/api/auth/confirmation`.
PUBLIC_SITE_URL=https://YOUR_DOMAIN

# Stripe reste strictement serveur. Utiliser de nouvelles clés après révocation
# de toute clé qui aurait été partagée dans une conversation ou un dépôt.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_ENDPOINT_ID=we_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# US fiscal TEST admission only. All gates default to false. Configure these
# as PRIVATE worker bindings after migration/staging approval; never NEXT_PUBLIC.
# Each workspace uses a dedicated sandbox account and restricted TEST key.
# Keep these separate from STRIPE_SECRET_KEY (Zentra SaaS subscriptions).
INTERNATIONAL_US_TAX_TEST_MERCHANT_ENABLED=false
INTERNATIONAL_US_TAX_TEST_MERCHANTS_JSON={"schemaVersion":1,"merchants":[]}
INTERNATIONAL_US_TAX_TEST_CREDENTIALS_JSON={}
# Descriptor shape: {organizationId,reference,revision,accountId}; credentials
# map: reference -> rk_test_... . Increment revision whenever the key rotates.
# Real keys belong in the secret store, not this file or browser forms.

# Signature des licences, strictement serveur.
LICENSE_SIGNING_KEY_PKCS8_B64URL=REPLACE_ME
# Une empreinte unique reste compatible. Séparer plusieurs installations
# propriétaire par une virgule, un point-virgule ou un espace.
OWNER_LICENSE_BINDING_SHA256=REPLACE_ME
