# Supabase Auth est appelé uniquement par les routes serveur de Zentra.
# La clé publiable est la seule clé Supabase utilisée par ce flux : ne jamais
# ajouter une clé secret/service_role dans un bundle navigateur.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Origine canonique HTTPS du site. Définir cette même origine comme Site URL
# dans Supabase Auth et autoriser exactement `/api/auth/confirmation`.
PUBLIC_SITE_URL=https://YOUR_DOMAIN

# Stripe reste strictement serveur. Utiliser de nouvelles clés après révocation
# de toute clé qui aurait été partagée dans une conversation ou un dépôt.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_ENDPOINT_ID=we_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# Signature des licences, strictement serveur.
LICENSE_SIGNING_KEY_PKCS8_B64URL=REPLACE_ME
OWNER_LICENSE_BINDING_SHA256=REPLACE_ME
