  "invariants": {
    "authority": "Three commercial commands admit members; financial commands/retries require owner/admin/accountant plus Gestion. Fresh authority around async ports, canonical stored event determines direct commit replay permission, synchronous living authorizer at memory CAS.",
    "history": "Immutable ERP4 baseline/policy/promotion, ordered mixed events, shared global book revision, exact reconstructed commands/records/commits/effects.",
    "projection": "Private transient ERP4 source removes only corroborated customer_credit postings and compacts its audit/journal revisions. Actual V5 ledger retains original credits/revisions; existing guarded accounting primitives independently re-admit each actual effect.",
    "issuance": "Public wrapper cannot submit seller/tax facts. Trusted read-only resolver supplies immutable facts; validation at real execution time, replay at original actor/time. Synthetic provider evidence is not a real transaction or fiscal approval.",
    "settlement": "Actual received, credited and outstanding distinct; new invoices, vendor bills/payments, manual entries and periods coexist. Legacy record_payment excluded.",
    "retry": "One V5 key/receipt namespace, canonical actor/request/revision hash, lost response and restore. 200-character new keys. Legacy baseline does not contain all ERP4 receipts; durable promotion must import their index.",
    "errors": "Corrupted private read/commit book normalized503; access/CAS conflicts distinct. Revocation postflight wins over async failures.",
    "atomicity": "One-process memory CAS, no final await between authorization/CAS/book+receipt write. No distributed or durable transaction claim."
  },
