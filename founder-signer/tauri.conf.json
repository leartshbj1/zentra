{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zentra Fondateur",
  "mainBinaryName": "ZentraFondateur",
  "version": "1.1.0",
  "identifier": "ch.zentra.founder",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Zentra Fondateur", "width": 1140, "height": 850, "minWidth": 820, "minHeight": 650, "center": true, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"], "publisher": "Zentra" }
}
