{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelviChantier",
  "version": "1.0.0",
  "identifier": "ch.helvichantier.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HelviChantier",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HelviChantier",
    "shortDescription": "Gestion de chantier, devis, facturation et salaires",
    "longDescription": "HelviChantier centralise localement les clients, chantiers, devis, factures, heures, dépenses, employés et fiches de salaire.",
    "category": "Business",
    "copyright": "Copyright © 2026 HelviChantier",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
