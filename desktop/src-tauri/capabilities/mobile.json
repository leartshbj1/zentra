{
  "identifier": "mobile-files",
  "description": "Copie des fichiers explicitement sélectionnés vers le cache privé de Zentra",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    { "identifier": "fs:scope", "allow": ["$APPCACHE/imports", "$APPCACHE/imports/**"] }
  ]
}
