{
  "name": "zentra-desktop",
  "version": "1.18.0",
  "private": true,
  "description": "Application Windows locale de gestion d’entreprise multisectorielle Zentra",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:ui": "vitest run",
    "build:web": "tsc --noEmit && vite build",
    "build": "pnpm build:web && tauri build --target x86_64-pc-windows-gnu --bundles nsis",
    "build:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-updater-release.ps1",
    "release:stage-updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-updater-release.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.0.18"
  }
}
