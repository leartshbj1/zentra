diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..6a140b94d626c35f6d1b95490fb77242cb2c4a58
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,22 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. This ceiling cannot be disabled.
+const MAX_DEPTH = 100;
+exports.MAX_DEPTH = MAX_DEPTH;
+exports.guard = () => {
+  const path = new Set();
+  return (node, depth, visit) => {
+    // Scalar leaves do not recurse; a parsed pattern at 100 blocks has leaves
+    // one level below those blocks. Ignore parent/prev links and sibling reuse.
+    if (depth > MAX_DEPTH && node.nodes) {
+      throw new SyntaxError(`Brace pattern nesting exceeds max depth (${MAX_DEPTH})`);
+    }
+    if (path.has(node)) throw new SyntaxError('Cyclic brace AST');
+    path.add(node);
+    try {
+      return visit();
+    } finally {
+      path.delete(node);
+    }
+  };
+};
