# Experimental international paths stay disabled unless all reviewed migrations
# and an approved country-specific billing/catalogue setup are installed.
INTERNATIONAL_CORE_ENABLED=false
INTERNATIONAL_US_CREATION_ENABLED=false
INTERNATIONAL_US_ERP_ENABLED=false

# Explicit TEST or PRODUCTION. Empty/missing denies US rights.
INTERNATIONAL_US_BILLING_ENVIRONMENT=

# Server-controlled entries: [{"offer":{...SaasSubscriptionOffer},"seatLimit":3}].
# Empty by default: no arbitrary US price, entitlement, discount or trial.
# Offers must use US/USD and the exact environment above, with verified Stripe
# Price/Product IDs and integer minor units. This setting is not a payment proof.
INTERNATIONAL_US_SAAS_CATALOG_JSON=[]
